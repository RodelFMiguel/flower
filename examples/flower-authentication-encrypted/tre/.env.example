# TRE Flower Microservices Environment Configuration
# Copy this file to .env and adjust values as needed

# Number of data owner nodes
NUM_NODES=2

# Analyzer Service
ANALYZER_PORT=5000
SUPERLINK_FLEET_API_ADDRESS=0.0.0.0:9092
SUPERLINK_CONTROL_API_ADDRESS=0.0.0.0:9093
SUPERLINK_SERVERAPPIO_API_ADDRESS=0.0.0.0:9091
SUPERLINK_INSECURE=false
SUPERLINK_ENABLE_AUTH=true

# Data Owner Services
DATAOWNER_BASE_PORT=5001
SUPERLINK_ADDRESS=analyzer:9092

# Database (PostgreSQL)
POSTGRES_USER=flower
POSTGRES_PASSWORD=flower_secret
POSTGRES_DB=flower_federation

# Paths (inside containers)
FLOWER_APP_PATH=/app/flower-app
DATA_DIR=/app/data
CERTIFICATES_DIR=/app/data/certificates
KEYS_DIR=/app/data/keys
ENCRYPTION_KEYS_DIR=/app/data/encryption_keys
