# Dockerfile for TRE Data Owner (SuperNode) Service
FROM python:3.10-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    openssl \
    openssh-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy requirements first for better caching
COPY tre/requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

# Copy the flower app (authexample package)
COPY authexample /app/flower-app/authexample/
COPY pyproject.toml /app/flower-app/

# Install the flower app
WORKDIR /app/flower-app
RUN pip install -e .

# Copy TRE service code
WORKDIR /app
COPY tre/shared /app/shared/
COPY tre/dataowner_service /app/dataowner_service/

# Create data directories
RUN mkdir -p /app/data/certificates /app/data/keys /app/data/encryption_keys /app/data/datasets /app/data/models

# Set default environment variables (can be overridden)
ENV NODE_ID=1
ENV DATA_DIR=/app/data
ENV DATASET_PATH=/app/data/datasets/cifar10_part_1
ENV KEYS_DIR=/app/data/keys
ENV ENCRYPTION_KEYS_DIR=/app/data/encryption_keys
ENV CERTIFICATES_DIR=/app/data/certificates
ENV MODELS_DIR=/app/data/models
ENV SUPERLINK_ADDRESS=superlink:9092

# Expose ports
# Flask API
EXPOSE 5001
# SuperNode ClientAppIo API
EXPOSE 9094

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5001/health || exit 1

# Run the Flask app with gunicorn
CMD ["gunicorn", "--bind", "0.0.0.0:5001", "--workers", "2", "--threads", "4", "dataowner_service.app:create_app()"]
